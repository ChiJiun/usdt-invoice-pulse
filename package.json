{
  "name": "usdt-invoice-pulse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "test:unit": "python -m unittest discover -s tests -p \"test_*.py\"",
    "test": "npm run test:unit && npm run build",
    "bot:dry": "python -m bot.runner --dry-run",
    "bot:verify": "python -m bot.verify",
    "invoice:sync": "python -m bot.gmail_invoices"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
